# Copy to /etc/jinai-agents.env (mode 600) on the server.

# Required
ANTHROPIC_API_KEY=sk-ant-...
JINAI_ADMIN_TOKEN=change-me-long-random          # what you type on the sign-in page
JINAI_SECRET_KEY=                                # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JINAI_DATABASE_URL=postgresql+psycopg2://jinai_agents:password@localhost/jinai_agents
JINAI_PUBLIC_URL=https://agents.example.com      # used in webhook URLs and alert emails
JINAI_DATA_DIR=/var/lib/jinai-agents
JINAI_OWNER_EMAIL=you@example.com                # default recipient for messages and alerts

# Runner: "process" runs agents as local processes (only for your own agents);
# "docker" runs each run in a locked-down container (build deploy/runner.Dockerfile first).
JINAI_RUNNER=docker
JINAI_RUNNER_IMAGE=jinai-runner:latest
JINAI_INTERNAL_URL=http://host.docker.internal:8300   # how a running agent reaches this server for AI calls
                                                      # (process runner: http://127.0.0.1:8300)
JINAI_WORKERS=4

# Models and cost tracking (USD per million tokens; check current pricing)
JINAI_BUILDER_MODEL=claude-sonnet-5-5
JINAI_AGENT_MODEL=claude-sonnet-5-5
JINAI_PRICE_IN_PER_MTOK=3
JINAI_PRICE_OUT_PER_MTOK=15
JINAI_REPAIRS_PER_DAY=3

# Email (without it, messages are kept in each run's record)
JINAI_SMTP_HOST=smtp.resend.com
JINAI_SMTP_PORT=587
JINAI_SMTP_USER=resend
JINAI_SMTP_PASSWORD=
JINAI_SMTP_FROM=agents@example.com
JINAI_WEB_DIR=/opt/jinai-agents/web/out
